# Copier vers .env (jamais commité).

# Outils retirés de l'agent (noms séparés par des virgules).
# Par défaut : pas de réplication, pas de financement d'enfants, pas de mise à jour
# de son propre code depuis GitHub, pas de transferts de crédits.
AUTOMATON_DISABLED_TOOLS=spawn_child,fund_child,pull_upstream,reset_to_upstream,transfer_credits

# Montant maximal (USD) d'un achat de crédits Conway via topup_credits.
AUTOMATON_MAX_TOPUP_USD=5

# RPC Base à utiliser (optionnel). Par défaut, celui d'automaton.
# Si tu le changes, ajoute son domaine dans proxy/domaines-autorises.txt.
# AUTOMATON_RPC_URL=https://mainnet.base.org

# Clés d'inférence optionnelles. ATTENTION : l'agent peut les lire via son shell.
# Utilise des clés dédiées, avec un plafond de dépenses chez le fournisseur.
# Décommente aussi api.openai.com / api.anthropic.com dans proxy/domaines-autorises.txt.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
